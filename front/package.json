{
  "name": "margins-front",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "tsc --project tsconfig.storybook.json && storybook build --disable-telemetry",
    "test:storybook": "vitest run --config .storybook/vitest.config.ts",
    "test:storybook:visual": "node scripts/storybook-visual.mjs test",
    "test:storybook:visual:setup": "node scripts/storybook-visual.mjs setup",
    "test:storybook:visual:update": "node scripts/storybook-visual.mjs update",
    "test:storybook:tools": "node --test scripts/storybook-environment.test.mjs",
    "test:design-system": "npm run test:storybook:tools && npm run build-storybook && npm run test:storybook && npm run test:storybook:visual && node scripts/verify-design-system.mjs",
    "audit:contrast": "playwright test --config playwright.contrast.config.ts",
    "dev": "vite --host 127.0.0.1",
    "dev:shared-dev": "vite --host 127.0.0.1 --mode dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run e2e",
    "test:unit": "vitest run src",
    "test:unit:focused": "node scripts/test-unit-focused.mjs",
    "lint": "eslint src .storybook tests/storybook eslint.config.js scripts/audit-architecture.mjs scripts/audit-form-ownership.mjs scripts/serve-storybook.mjs scripts/storybook*.mjs scripts/test-unit-focused.mjs scripts/verify-design-system.mjs && npm run audit:architecture && npm run audit:form-ownership",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:architecture:final": "node scripts/audit-architecture.mjs --final",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pree2e": "node scripts/check-e2e-prereqs.mjs",
    "e2e": "playwright test",
    "e2e:auth-mock": "playwright test --config playwright.auth-mock.config.ts",
    "e2e:auth-mock:debug": "playwright test --config playwright.auth-mock.config.ts --debug",
    "e2e:headed": "npm run pree2e && playwright test --headed",
    "e2e:debug": "npm run pree2e && playwright test --debug",
    "e2e:ui": "npm run pree2e && playwright test --ui",
    "screenshots:workbench": "node scripts/capture-workbench-screenshots.mjs",
    "verify:search-metadata": "node scripts/verify-search-metadata.mjs",
    "audit:ui": "node scripts/audit-ui-primitives.mjs",
    "audit:form-ownership": "node scripts/audit-form-ownership.mjs --fixtures && node scripts/audit-form-ownership.mjs",
    "openapi:pull": "node scripts/pull-openapi.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "motion": "^13.1.1",
    "postcss": "^8.4.49",
    "radix-ui": "^1.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^6.30.4",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "4.13.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "1.60.0",
    "prettier": "3.9.4",
    "storybook": "10.6.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.11"
  }
}
