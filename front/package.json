{
  "name": "margins-front",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run e2e",
    "test:unit": "vitest run src",
    "lint": "eslint src eslint.config.js scripts/audit-architecture.mjs scripts/audit-form-ownership.mjs && npm run audit:architecture && npm run audit:form-ownership",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:architecture:final": "node scripts/audit-architecture.mjs --final",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pree2e": "node scripts/check-e2e-prereqs.mjs",
    "e2e": "playwright test",
    "screenshots:workbench": "node scripts/capture-workbench-screenshots.mjs",
    "audit:ui": "node scripts/audit-ui-primitives.mjs",
    "audit:form-ownership": "node scripts/audit-form-ownership.mjs --fixtures && node scripts/audit-form-ownership.mjs",
    "openapi:pull": "node scripts/pull-openapi.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "motion": "^13.1.1",
    "postcss": "^8.4.49",
    "radix-ui": "^1.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^6.30.6",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.8"
  }
}
