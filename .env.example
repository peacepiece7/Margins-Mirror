# Local development only. Never reuse these defaults on an internet-accessible host.

MARGINS_FRONTEND_PORT=9613
MARGINS_BACKEND_PORT=5813
MARGINS_BACKEND_URL=http://localhost:5813
MARGINS_MYSQL_PORT=3813
MARGINS_MYSQL_CONTAINER_NAME=margins-dev-mysql
MARGINS_MYSQL_VOLUME_NAME=margins_dev_mysql_data
MARGINS_MYSQL_DATABASE=margins
MARGINS_MYSQL_USER=margins
MARGINS_MYSQL_PASSWORD=margins-pass
MARGINS_MYSQL_ROOT_PASSWORD=margins-root

# Optional local integrations. Keep real values in an ignored .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GOOGLE_BOOKS_API_KEY=
MARGINS_GOOGLE_OAUTH_ENABLED=false
MARGINS_GOOGLE_CLIENT_ID=
MARGINS_GOOGLE_CLIENT_SECRET=
MARGINS_AUTH_JWT_SECRET=
MARGINS_AUTH_CHALLENGE_SECRET=
RESEND_API_KEY=
VITE_MARGINS_TURNSTILE_SITE_KEY=
MARGINS_TURNSTILE_SECRET_KEY=
