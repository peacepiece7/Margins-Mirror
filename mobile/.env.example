# Public origins only. Never place API keys, tokens, profile data, or private content in EXPO_PUBLIC_*.
# iOS simulator: http://localhost:5813
# Android emulator: http://10.0.2.2:5813
EXPO_PUBLIC_API_BASE_URL=
# Required for release Google OAuth; use the verified HTTPS app link.
EXPO_PUBLIC_OAUTH_REDIRECT_URI=
# Production builds must use the same verified HTTPS return URI as the backend bridge.
EXPO_PUBLIC_EMAIL_VERIFICATION_REDIRECT_URI=
