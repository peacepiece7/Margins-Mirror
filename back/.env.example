# Copy to back/.env; keep this file out of Git. Use your local Docker MySQL credentials.
SPRING_PROFILES_ACTIVE=local
MARGINS_DB_TARGET=local
MARGINS_MYSQL_PORT=3306
MARGINS_MYSQL_DATABASE=margins
MARGINS_MYSQL_USER=margins
MARGINS_MYSQL_PASSWORD=
MARGINS_MYSQL_ROOT_PASSWORD=
MARGINS_DB_URL=jdbc:mysql://127.0.0.1:3306/margins?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MARGINS_BACKEND_PORT=5813
MARGINS_CORS_ALLOWED_ORIGIN=http://localhost:9613
MARGINS_PUBLIC_BASE_URL=http://localhost:5813
MARGINS_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_DEBUG_MODEL=gpt-6-luna
OPENAI_DEBUG_MAX_OUTPUT_TOKENS=500
MARGINS_DEVELOPER_DEBUG_ENABLED=false
MARGINS_GOOGLE_OAUTH_ENABLED=true
MARGINS_GOOGLE_CLIENT_ID=
MARGINS_GOOGLE_CLIENT_SECRET=
MARGINS_GOOGLE_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:9613/auth/callback
MARGINS_MAIL_VERIFICATION_ENABLED=true
MARGINS_MAIL_VERIFICATION_EXPOSE_CODE=false
MARGINS_MAIL_FROM=
RESEND_API_KEY=
MARGINS_CONTACT_ENABLED=true
MARGINS_CONTACT_RECIPIENT=
MARGINS_TURNSTILE_SECRET_KEY=
MARGINS_TURNSTILE_ALLOWED_HOSTNAMES=localhost
MARGINS_EMAIL_VERIFICATION_ABUSE_PROTECTION_ENABLED=false
