{
  "name": "margins-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "local:doctor": "node tooling/workspace/local.mjs doctor",
    "local:install": "node tooling/workspace/local.mjs install",
    "local:db:up": "node tooling/workspace/local.mjs db-up --apply-schema",
    "local:db:down": "node tooling/workspace/local.mjs db-down",
    "local:db:config": "node tooling/workspace/local.mjs local-db-config",
    "local:dev": "node tooling/workspace/local.mjs dev",
    "quality": "node tooling/workspace/local.mjs quality",
    "test:back": "node tooling/workspace/local.mjs back-test",
    "test:front": "npm --prefix front run test:unit",
    "test:mobile": "npm --prefix mobile test",
    "quality:mobile": "npm --prefix mobile run quality",
    "mobile:start": "npm --prefix mobile start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android",
    "test:back:integration": "node tooling/workspace/local.mjs back-test-integration",
    "test:e2e": "node tooling/workspace/e2e.mjs",
    "test": "npm run test:back && npm run test:front"
  }
}
